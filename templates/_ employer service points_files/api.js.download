-zuidlimburg.nl\/<\/a>  <\/div>         <div class=\"email\">    <a href=\"mailto:info@werkcentrum-zuidlimburg.nl\">info@werkcentrum-zuidlimburg.nl<\/a>  <\/div>  <\/div>"},"wsp_19":{"id":"19","title":"WSP Zuidoost-Brabant: 04werkt","lat":"51.4447579","lng":"5.4710296","url":"https:\/\/www.werkgeversservicepunten.nl\/wsp\/wsp-zuidoost-brabant-04werkt","details":"<h2>WSP Zuidoost-Brabant: 04werkt<\/h1><div class=\"details\">    <div class=\"address\">    Pastoor Petersstraat 134-166<br \/>5612 LV Eindhoven  <\/div>        <div class=\"phone\">        <a href=\"tel:0407004038\">      040 700 40 38    <\/a>  <\/div>                    <div class=\"municipalities\">    Bergeijk, Best, Bladel, Eersel, Eindhoven, Heeze-Leende, Nuenen CA, Oirschot, Reusel-De Mierden, Son en Breugel, Valkenswaard, Veldhoven, Waalre  <\/div>        <div class=\"website\">    <a href=\"http:\/\/www.huisnaarwerk.nl\/\" target=\"_blank\">www.huisnaarwerk.nl<\/a>  <\/div>         <div class=\"email\">    <a href=\"mailto:info@04werkt.nl\">info@04werkt.nl<\/a>  <\/div>  <\/div>"},"wsp_47":{"id":"47","title":"WSP Zwolle","lat":"52.5037621","lng":"6.0849164","url":"https:\/\/www.werkgeversservicepunten.nl\/wsp\/wsp-zwolle","details":"<h2>WSP Zwolle<\/h1><div class=\"details\">    <div class=\"address\">    Hanzelaan 180<br \/>8017 JG Zwolle  <\/div>        <div class=\"phone\">        <a href=\"tel:0387001205\">      038 700 12 05    <\/a>  <\/div>                    <div class=\"municipalities\">    Elburg, Dalfsen, Hardenberg, Hattem, Kampen, Meppel, Nunspeet, Oldebroek, Olst-Wijhe, Ommen, Raalte, Staphorst, Steenwijkerland, Westerveld, Zwartewaterland, Zwolle  <\/div>        <div class=\"website\">    <a href=\"https:\/\/wspregiozwolle.nl\/\" target=\"_blank\">wspregiozwolle.nl<\/a>  <\/div>         <div class=\"email\">    <a href=\"mailto:info@wspregiozwolle.nl\">info@wspregiozwolle.nl<\/a>  <\/div>  <\/div>"}}
  },
  init: function() {
    // check if jquery and jquery-ui are already loaded
    if(typeof($) !== 'undefined') {
      wsp.config.libraries.jquery.loaded = true;
      
      if(typeof($.ui) !== 'undefined') {
        wsp.config.libraries.jqueryui.loaded = true;
        wsp.config.libraries.jqueryuicss.loaded = true;
      }
    }
    
    // include required libraries
    for(libraryName in wsp.config.libraries) {
      library = wsp.config.libraries[libraryName];
      if(!library.loaded) {
        switch(library.type) {
          case 'js':
            var tag = document.createElement('script');
            tag.setAttribute('src', library.url);
            tag.setAttribute('type', 'text/javascript');
            break;
            
          case 'css':
            var tag = document.createElement('link');
            tag.setAttribute('rel', 'stylesheet');
            tag.setAttribute('style', 'text/css');
            tag.setAttribute('href', library.url);
            break;
        }
      
        tag.setAttribute('data-label', libraryName);
        tag.onload = function() {
          wsp.checkLoaded(this.getAttribute('data-label'));
        }
        document.getElementsByTagName("head")[0].appendChild(tag);
      }
    }
  },
  checkLoaded: function(type) {
    // if jquery is loaded, set global $ variable
    if(type == 'jquery') {
      $ = window.jQuery;
    }
    
    // set library as loaded
    if(typeof(wsp.config.libraries[type]) != 'undefined') {
      wsp.config.libraries[type].loaded = true;
    }
    
    // if all libraries are loaded, continue application
    var allLoaded = true;
    for(libraryName in wsp.config.libraries) {
      if(!wsp.config.libraries[libraryName].loaded) {
        allLoaded = false;
      }
    }
    if(allLoaded) {
      wsp.initAPI();
    }
  },
  initAPI: function() {
    // check if container div is present
    if($('#wsp-zipsearch-container').length > 0) {
      $('#wsp-zipsearch-container').append($.parseHTML(wsp.config.template));
      
      wsp.initZipSearch();
      wsp.initMap();
      wsp.initList();
    }
  },
  initZipSearch: function() {
    $('#searchzipbutton').click(function() {
      $([document.documentElement, document.body]).animate({
        scrollTop: $('#wsp-map-wrapper').offset().top
      }, 200);
    });
    
    // close activated wsp when escape is pressed
    $(document).keyup(function(event) {
      if(event.key === 'Escape') {
        wsp.activateWsp();
      }
    });
    
    $('#searchzip').keyup(function(event) {
      var correctValue = '';
      var value = $(this).val().toUpperCase().replace(/[^A-Z0-9]/, '').substr(0,6);

      for(var i=0; i<value.length; i++) {
        if(i < 4 && value.charAt(i).match(/[^0-9]/) != null) {
          break;
        } else if(i > 3 && value.charAt(i).match(/[^A-Z]/) != null) {
          break;
        } else {
          correctValue += value.charAt(i);
        }
      }

      if($(this).val() != correctValue) {
        $(this).val(correctValue);
      }
      
      if($(this).val() != '') {
        $.get("https://www.werkgeversservicepunten.nl/wsp-api/search/" + $(this).val(), {}, function (data) {
          wsp.config.zipMatches = data;

          // show matching items in list
          $('.wsp-sidebar .wsp-list a.list-wsp-item').each(function(k, item) {
            var wspid = $(item).attr('data-wspid');
            if($.inArray(wspid, data) > -1) {
              $(item).addClass('match');
            } else {
              $(item).removeClass('match');
            }
          });

          // show matching items on map
          $.each(wsp.config.markers, function(id, marker) {
            if($.inArray(id, data) > -1) {
              marker.setVisible(true);
            } else {
              marker.setVisible(false);
            }
          });
          
          wsp.scrollPos();
          
          if(data.length == 1) {
            wsp.activateWsp(data[0]);
          } else {
            wsp.activateWsp();
          }
          
          if(data.length < 1) {
            $('.wsp-no-results').show();
          } else {
            $('.wsp-no-results').hide();
          }
        });
      } else {
        // searchfield is empty: show all
        wsp.activateWsp();
        $('.wsp-sidebar .wsp-list a.list-wsp-item').addClass('match');
        $.each(wsp.config.markers, function(id, marker) {
          marker.setVisible(true);
        });
      }
      
      // enter pressed?
      if(event.key === 'Enter') {
        if(typeof(wsp.config.zipMatches) == 'object' && wsp.config.zipMatches.length == 1) {
          wspid = wsp.config.zipMatches[0];
          if($('#list-wsp-item-' + wspid).length > 0) {
            wsp.activateWsp(wspid);
            $('#searchzipbutton').click();
          }
        }
      }
    });
  },
  initMap: function() {
    wsp.config.infoWindow = new google.maps.InfoWindow({ disableAutoPan: true });
    wsp.mapOverlay.prototype = new google.maps.OverlayView();
    wsp.mapOverlay.prototype.onAdd = function() {
      var div = document.createElement('div');
      div.style.borderStyle = 'none';
      div.style.borderWidth = '0px';
      div.style.position = 'absolute';

      var img = document.createElement('img');
      img.src = this.image_;
      img.style.width = '100%';
      img.style.height = '100%';
      img.style.position = 'absolute';
      div.appendChild(img);

      this.div_ = div;

      var panes = this.getPanes();
      panes.overlayLayer.appendChild(div);
    };

    wsp.mapOverlay.prototype.draw = function() {
      var overlayProjection = this.getProjection();
      var sw = overlayProjection.fromLatLngToDivPixel(this.bounds_.getSouthWest());
      var ne = overlayProjection.fromLatLngToDivPixel(this.bounds_.getNorthEast());
      var div = this.div_;
      div.style.left = sw.x + 'px';
      div.style.top = ne.y + 'px';
      div.style.width = (ne.x - sw.x) + 'px';
      div.style.height = (sw.y - ne.y) + 'px';
    };

    wsp.mapOverlay.prototype.onRemove = function() {
      this.div_.parentNode.removeChild(this.div_);
      this.div_ = null;
    };

    wsp.doInitMap();
  },
  doInitMap: function() {
    var mapOptions = {
      center: new google.maps.LatLng(52.1243423,5.274014),
      zoom: 7.8,
      mapTypeId: google.maps.MapTypeId.MAP,
      backgroundColor: 'transparent',
      disableDefaultUI: true,
      draggable: false,
      scaleControl: false,
      scrollwheel: false,
      gestureHandling: 'none',
      draggableCursor: 'default',
      styles: [
        {"featureType": "transit", "stylers": [{ "visibility": "off" }]},
        {"featureType": "water", "stylers": [{ "visibility": "off" }]},
        {"featureType": "landscape", "stylers": [{ "visibility": "off" }]},
        {"featureType": "road", "stylers": [{ "visibility": "off" }]},
        {"featureType": "administrative", "stylers": [{ "visibility": "off" }]},
        {"featureType": "poi", "stylers": [{ "visibility": "off" }]},
        {"elementType": "labels", "stylers": [{ "visibility": "off" }]}
      ]
    };

    wsp.config.map = new google.maps.Map(document.getElementById('wsp-map-canvas'), mapOptions);
    wsp.config.geocoder = new google.maps.Geocoder();

    wsp.config.bounds = new google.maps.LatLngBounds(
      new google.maps.LatLng(50.73, 3.34),
      new google.maps.LatLng(53.56, 7.2)
    );

    wsp.config.mapOverlay = new wsp.mapOverlay(wsp.config.bounds, 'https://www.werkgeversservicepunten.nl/themes/custom/wsp/images/nl.svg', wsp.config.map);
    if(typeof(wsp.config.wsps) == 'object') {
      $.each(wsp.config.wsps, function(k, wspItem) {
        var icon = {
          url: wsp.config.markerMouseOut,
          scaledSize: new google.maps.Size(27, 38)
        }
          
        wsp.config.markers[wspItem.id] = new google.maps.Marker({
          position: new google.maps.LatLng(wspItem.lat, wspItem.lng),
          map: wsp.config.map,
          wspTitle: wspItem.title,
          wspid: wspItem.id,
          icon: icon,
          url: wspItem.url
        });
        wsp.config.markers[wspItem.id].addListener('click', function() {
          wsp.activateWsp(this.wspid);
        });
        wsp.config.markers[wspItem.id].addListener('mouseover', function() {
          wsp.hoverWsp(this.wspid, true);
        });
        wsp.config.markers[wspItem.id].addListener('mouseout', function() {
          wsp.hoverWsp();
        });
      });
    }

    $(window).resize(function() {
      google.maps.event.trigger(wsp.config.map, 'resize');
    });
    setInterval(function() {
      $(window).resize();
    }, 100);

    google.maps.event.addListener(wsp.config.map, 'resize', function() {
      var width  = $('#wsp-map-wrapper').width();
      var height = $('#wsp-map-wrapper').height();
      if(width >= 1024) { // Map is never this big
        wsp.config.map.setZoom(7.8);
      } else if(width >= 975) { // Map is never this big
        var factor = (width - 975) / ((1280-975) / 100);
        zoom = 7.5 + ((0.3/100) * factor);
        zoom = Math.floor(zoom*100)/100;
        wsp.config.map.setZoom(zoom);
      } else if(width >= 719) { // 768vw
        wsp.config.map.setZoom(7.8);
      } else if(width >= 431) { // 480vw
        wsp.config.map.setZoom(7.2);
      } else if(width >= 271) { // 320vw
        wsp.config.map.setZoom(6.6);
      } else { // Less then 320vw
        wsp.config.map.fitBounds(wsp.config.bounds);
      }
    });
    
    // hide google stuff on bottom of map
    setInterval(function() {
      $('.gm-style a, .gmnoprint a, .gmnoprint span, .gm-style-cc').remove();
      $('.gmnoprint div').css({ background: 'none !important' });
    }, 500);
  },
  hoverWsp: function(wspid, scrollToItem) {
    // Check if touch device
    var touchPrefixes = ' -webkit- -moz- -o- -ms- '.split(' ');
    var mq = function (touchQuery) {
      return window.matchMedia(touchQuery).matches;
    }
    var isTouch = false;
    if (('ontouchstart' in window) || window.DocumentTouch && document instanceof DocumentTouch) {
      isTouch = true;
    } else {
      var touchQuery = ['(', touchPrefixes.join('touch-enabled),('), 'heartz', ')'].join('');
      isTouch = mq(touchQuery);
    }

    if (!isTouch) {
      if(typeof(scrollToItem) == 'undefined' || scrollToItem !== true) {
        scrollToItem = false;
      }
      
      if(typeof(wspid) == 'undefined') {
        wspid = 0;
      } else {
        wspid = parseInt(wspid);
      }

      $('.list-wsp-item').removeClass('hovering');
      $('#list-wsp-item-' + wspid).addClass('hovering');

      if(!wsp.config.isLoading) {
        var listInnerWrapper = $('div.wsp-sidebar div.wsp-list div.inner-wrapper');
        var scrollTop = null;
        
        $.each(wsp.config.markers, function(id, marker) {
          if(id != wsp.config.activeWsp) {
            if(id == wspid) {
              var item = $('#list-wsp-item-' + id);
              if($(item).length > 0) {
                scrollTop = $(item).position().top;
              }
              
              var icon = {
                url: wsp.config.markerMouseOver,
                scaledSize: new google.maps.Size(35, 50)
              }
            } else {
              var icon = {
                url: wsp.config.markerMouseOut,
                scaledSize: new google.maps.Size(27, 38)
              }
            }
            marker.setIcon(icon);
          }
        });
        
        if(scrollToItem && scrollTop !== null) {
          var liScrollTop = $(listInnerWrapper).scrollTop();
          scrollTop += liScrollTop;
          //if(scrollTop < liScrollTop || scrollTop > liScrollTop+$(listInnerWrapper).height()) {
            $(listInnerWrapper).scrollTop(scrollTop-50);
          //}
        }

        if(typeof(wsp.config.markers[wspid]) != 'undefined') {
          wsp.config.infoWindow.setContent(wsp.config.markers[wspid].wspTitle);
          wsp.config.infoWindow.open(wsp.config.map, wsp.config.markers[wspid]);
        } else {
          wsp.config.infoWindow.setContent('');
          wsp.config.infoWindow.close();
        }
      }
    }
  },
  activateWsp: function(wspid) {
    if($('#list-wsp-item-' + wspid).length > 0) {
      if(wspid != wsp.config.activeWsp) {
        wsp.config.activeWsp = wspid;
        var html = $.parseHTML(wsp.config.wsps['wsp_' + wspid].details);
        $('.wsp-sidebar .wsp-details-container').html(html);
        $('.wsp-sidebar').addClass('details').removeClass('list');
      }
    } else {
      wsp.config.activeWsp = 0;
      $('.wsp-sidebar .wsp-details-container').html('');
      $('.wsp-sidebar').addClass('list').removeClass('details');
    }
    
    $.each(wsp.config.markers, function(id, marker) {
      if(id == wspid) {
        var icon = {
          url: wsp.config.markerMouseOver,
          scaledSize: new google.maps.Size(35, 50)
        }
      } else {
        var icon = {
          url: wsp.config.markerMouseOut,
          scaledSize: new google.maps.Size(27, 38)
        }
      }
      marker.setIcon(icon);
    });
  },
  initList: function() {
    $('div.wsp-list a.list-wsp-item').mouseover(function() {
      wsp.hoverWsp($(this).attr('data-wspid'));
    }).mouseout(function() {
      wsp.hoverWsp();
    }).click(function() {
      wsp.activateWsp($(this).attr('data-wspid'));
    });
    $('.wsp-sidebar .wsp-details a.wsp-close-details').click(function() {
      wsp.activateWsp();
    });
    
    $('#wsp-map-wrapper div.wsp-sidebar div.inner-wrapper').scroll(function() {
      wsp.scrollPos();
    });
    wsp.scrollPos();
  },
  scrollPos: function() {
    var $ = jQuery;

    var overflowHeight = $('#wsp-map-wrapper div.wsp-sidebar div.inner-wrapper').height();
    var scrollPos = $('#wsp-map-wrapper div.wsp-sidebar div.inner-wrapper').scrollTop();
    var totalHeight =  $('#wsp-map-wrapper div.wsp-sidebar div.inner-wrapper div.inner').height();
    
    if(totalHeight == overflowHeight) {
      var noScroll = true;
    } else {
      var scrollPercentage = 100 / Math.floor( totalHeight - overflowHeight ) * scrollPos;
      var noScroll = false;
    }

    if (scrollPercentage <= 0 || noScroll) {
      $('#wsp-map-wrapper div.wsp-sidebar div.wsp-list').addClass('pos_top');
    } else {
      $('#wsp-map-wrapper div.wsp-sidebar div.wsp-list').removeClass('pos_top');
    }

    if (scrollPercentage >= 99 || noScroll) {
      $('#wsp-map-wrapper div.wsp-sidebar div.wsp-list').addClass('pos_bot');
    } else {
      $('#wsp-map-wrapper div.wsp-sidebar div.wsp-list').removeClass('pos_bot');
    }
  },
  mapOverlay: function(bounds, image, map) {
    this.bounds_ = bounds;
    this.image_ = image;
    this.map_ = map;
    this.div_ = null;
    this.setMap(map);
  }
}

window.onload = function() {
  wsp.init();
}